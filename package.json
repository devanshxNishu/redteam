{
  "name": "redteam",
  "version": "0.61.0",
  "private": true,
  "type": "module",
  "description": "Ideas and apps: controlled evidence, structured review planning, and bounded stakeholder mechanics.",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "redteam": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "examples",
    "fixtures",
    "README.md",
    "docs/master-plan.md",
    "docs/development-backlog.md",
    "docs/implementation-status.md",
    "docs/research-registry.md",
    "docs/actor-runtime.md",
    "docs/live-inference.md",
    "docs/budget-ledger.md",
    "docs/task-state.md",
    "docs/evidence-publication.md",
    "docs/report-diagnostics.md",
    "docs/repository-snapshots.md",
    "docs/engineering-observations.md",
    "docs/code-dashboard.md",
    "docs/actions.md",
    "docs/comparisons.md",
    "docs/experiment-plans.md",
    "docs/report-export.md",
    "docs/installation-preflight.md",
    "docs/outcome-evidence.md",
    "docs/idea-and-app-scope.md",
    "docs/review-briefs.md",
    "docs/analytical-review-plan.md",
    "docs/analytical-review.md",
    "docs/analyst-generation.md",
    "docs/analyst-task.md",
    "docs/analyst-configuration.md",
    "docs/analyst-invocations.md",
    "docs/analyst-transport.md",
    "docs/analyst-manifests.md",
    "docs/global-context-plan.md",
    "docs/global-context.md",
    "docs/context-records.md",
    "docs/context-collector.md",
    "docs/context-collection.md",
    "docs/node-release-context.md",
    "docs/node-release-sources.md",
    "docs/context-analysis.md",
    "docs/context-processing.md",
    "docs/context-analyst-generation.md",
    "docs/context-analyst-configuration.md",
    "docs/context-analyst-manifests.md",
    "docs/context-analyst-task.md",
    "docs/context-analyst-invocations.md",
    "docs/context-analyst-transport.md",
    "docs/context-analyst-candidates.md",
    "docs/context-analyst-candidate-reader.md",
    "docs/context-analyst-coordinator.md",
    "docs/context-analyst-report-reader.md",
    "docs/context-analyst-catalog.md",
    "docs/context-analyst-inspection.md",
    "docs/context-analyst-workspace.md",
    "docs/context-command.md",
    "docs/context-analyst-diagnostics.md",
    "docs/context-analyst-api.md",
    "docs/context-reports-web.md",
    "docs/context-operator-review.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "ui": "node src/cli.ts ui",
    "redteam": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "demo": "node src/cli.ts demo",
    "demo:fixed": "node src/cli.ts demo --variant fixed",
    "verify": "node src/cli.ts verify",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright playwright install chromium --only-shell"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
